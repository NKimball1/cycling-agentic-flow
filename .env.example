# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored so your key never gets committed.

# Your Anthropic API key (from https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Your Functional Threshold Power in watts. Required for Normalized Power,
# Intensity Factor, and TSS. Set it to your current FTP.
FTP_WATTS=250

# Optional: body weight in pounds, used for power-to-weight (W/kg) context.
WEIGHT_LB=165

# Heart-rate anchors for cross-sport load (hr_tss), covering runs and walks too.
RESTING_HR=39
THRESHOLD_HR=163

# Which LLM backs the analysis. Only "anthropic" is implemented today.
LLM_PROVIDER=anthropic
# Model for the Anthropic adapter. See README for options.
CLAUDE_MODEL=claude-opus-5

# --- Strava API (Phase 2) ---
# From your Strava API application: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=your-strava-client-secret

# --- Notifications (Phase 3) ---
# Active delivery channels, comma-separated. Empty = nothing is sent.
NOTIFY_CHANNELS=email
# Gmail: your address + a 16-char App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords). This is NOT your normal password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Recipient (leave blank to send to yourself, i.e. GMAIL_ADDRESS).
NOTIFY_TO=

# --- Discord approver bot (optional; interactive plan-adjustment approval) ---
# Run discord_bot.py to approve/reject proposals with buttons from your phone.
# By default it DMs you (private); nothing is posted in a server. Create a bot at
# https://discord.com/developers/applications (no privileged intents needed) and
# invite it (Send Messages + Embed Links) to any server you share with it — a bot
# can only DM a user it shares a server with.
DISCORD_BOT_TOKEN=
# Enable Developer Mode, right-click your username -> Copy ID. The bot DMs you
# here and only this user may approve.
DISCORD_APPROVER_ID=
# Optional: a channel id to post in a channel INSTEAD of DMing you.
DISCORD_CHANNEL_ID=
