# Secrets
.env
.strava_tokens.json

# Local sync state
.synced_ids.json

# Observability / eval data (accumulated telemetry — not the eval definitions)
runs.db

# Python
__pycache__/
*.pyc

# Temp files from atomic writes (should be transient; ignored so a crashed
# write can't leave personal data staged for commit).
*.tmp
.venv/
venv/

# Generated analyses
output/

# Personal data — NEVER commit (contains health info, training details, etc.).
# The *.example.json templates are committed instead, to document the schema.
data/training_plan.json
data/recent_activities.json
data/plan_adjustments.json

# Your exported ride files
data/*.fit

# Backups of personal data (from history normalization, etc.)
data/*.bak
data/*.backup*.json

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
