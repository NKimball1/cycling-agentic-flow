# EditorConfig — consistent formatting across editors and OSes.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Data/config formats conventionally use 2-space indents.
[*.{json,yml,yaml,md}]
indent_size = 2

# Markdown uses trailing whitespace for hard line breaks — don't strip it.
[*.md]
trim_trailing_whitespace = false
